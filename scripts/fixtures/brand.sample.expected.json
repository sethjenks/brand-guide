  "identity": {
    "mission": "Hold brand meaning in the repo so humans and agents share one source of truth.",
    "vision": "Every team that clones this kit ships on-brand work without reverse-engineering a PDF.",
    "values": [
      "Clarity",
      "Craft",
      "Portability"
    ],
    "origin": "Built as the default grayscale template inside this brand-guide kit so teams start from a finished example, not blank scaffolds."
  },
  "positioning": {
    "audience": "Founders, designers, and builders who ship with AI tools and need shared brand context.",
    "differentiation": "File-based, grayscale-first, dual audience (human guide + agent API).",
    "only_we": [
      "A starter that ships a filled Sample Brand, a visual guide, and a compiled `brand.json` in one repo."
    ]
  },
  "personality": {
    "archetypes": [
      "Editor"
    ],
    "traits": {
      "direct": 5,
      "warm": 3,
      "playful": 1
    },
    "anti_personality": [
      "Hype-driven",
      "Vague",
      "Performatively premium",
      "Loud for its own sake"
    ]
  },
  "voice": {
    "default": {
      "pillars": [
        "Direct",
        "Calm",
        "Specific"
      ],
      "do": [
        "Lead with the user’s job to be done",
        "Prefer short sentences",
        "Use concrete nouns"
      ],
      "dont": [
        "Hype without proof",
        "Vague benefits",
        "Corporate euphemism"
      ],
      "vocabulary": {
        "use": [
          "build",
          "ship",
          "clear",
          "plain",
          "specific",
          "guide"
        ],
        "never": [
          "synergistic",
          "best-in-class",
          "seamless",
          "revolutionary",
          "unlock your potential"
        ]
      },
      "phrases": [
        "Clear work, plainly said.",
        "If it needs a synonym, it needs a rewrite.",
        "The brand lives where the work lives.",
        "Grayscale first; meaning first.",
        "Specific beats impressive.",
        "Agents read this file too.",
        "Ornament is optional; clarity is not."
      ],
      "we_say": [
        "Here’s what changed and why.",
        "Ship the brand with the work.",
        "Plain language, strong contrast.",
        "Specific beats impressive."
      ],
      "we_never_say": [
        "Unlock your potential.",
        "Synergistic brand solutions.",
        "Seamless holistic experience.",
        "World-class premium vibes."
      ]
    }
  },
