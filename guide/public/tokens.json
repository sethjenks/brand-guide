    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-2",
          "guide": "interface"
        }
      }
    },
    "3": {
      "$type": "dimension",
      "$value": "1rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-3",
          "guide": "interface"
        }
      }
    },
    "4": {
      "$type": "dimension",
      "$value": "1.5rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-4",
          "guide": "interface"
        }
      }
    },
    "5": {
      "$type": "dimension",
      "$value": "2.5rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-5",
          "guide": "interface"
