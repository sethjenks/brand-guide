      }
    },
    "6": {
      "$type": "dimension",
      "$value": "4rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-6",
          "guide": "interface"
        }
      }
    },
    "7": {
      "$type": "dimension",
      "$value": "6rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-7",
          "guide": "interface"
        }
      }
    },
    "unit": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--space-unit",
          "guide": "interface"
        }
      }
    }
  },
  "type": {
    "base": {
      "$type": "number",
      "$value": 16,
      "$extensions": {
        "com.brand-guide": {
          "css": "--type-base",
          "guide": "interface"
        }
      },
      "$description": "Modular scale base (px); compiles to Astryx `typography.scale.base` and `--font-size-*` steps"
    },
    "ratio": {
      "$type": "number",
      "$value": 1.2,
      "$extensions": {
        "com.brand-guide": {
          "css": "--type-ratio",
          "guide": "interface"
        }
      },
      "$description": "Modular scale ratio; compiles to Astryx `typography.scale.ratio"
    }
