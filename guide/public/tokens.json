  "layout": {
    "content-max": {
      "$type": "dimension",
      "$value": "65ch",
      "$extensions": {
        "com.brand-guide": {
          "css": "--content-max",
          "guide": "interface"
        }
      }
    },
    "guide-max": {
      "$type": "dimension",
      "$value": "60rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--guide-max",
          "guide": "interface"
        }
      }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "var(--font-geist-sans)",
        "Geist",
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ],
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-sans",
          "guide": "interface"
        }
      },
      "$description": "Display + body"
    },
    "weight": {
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": {
          "com.brand-guide": {
            "css": "--font-weight-medium",
            "guide": "interface"
          }
        },
        "$description": "Labels"
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "com.brand-guide": {
            "css": "--font-weight-regular",
            "guide": "interface"
          }
        },
        "$description": "Body"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$extensions": {
          "com.brand-guide": {
            "css": "--font-weight-semibold",
            "guide": "interface"
          }
        },
        "$description": "Headings"
      }
    }
  },
  "text": {
    "base": {
      "$type": "dimension",
      "$value": "1rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-base",
          "guide": "interface"
        }
      },
      "$description": "Body"
    },
    "display": {
      "$type": "dimension",
      "$value": "clamp(2.75rem, 6vw, 4.25rem)",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-display",
          "guide": "interface"
        }
      },
      "$description": "Cover / hero brand name (authored fluid)"
    },
    "h0": {
      "$type": "dimension",
      "$value": "clamp(4.5rem, 14vw, 9rem)",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-h0",
          "guide": "interface"
        }
      },
      "$description": "Chapter openers (authored fluid)"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.1875rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-lg",
          "guide": "interface"
        }
      },
      "$description": "Lead"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.8125rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-sm",
          "guide": "interface"
        }
      },
      "$description": "Captions, meta"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.4375rem",
      "$extensions": {
        "com.brand-guide": {
          "css": "--font-size-xl",
          "guide": "interface"
        }
      },
      "$description": "Section titles"
    },
    "lineHeight": {
      "body": {
        "$type": "number",
        "$value": 1.55,
        "$extensions": {
          "com.brand-guide": {
            "css": "--line-height-body",
            "guide": "interface"
          }
        },
        "$description": "Body copy"
      }
    }
